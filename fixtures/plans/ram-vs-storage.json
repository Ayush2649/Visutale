  "topic": "RAM vs Storage: Understanding Computer Memory",
  "audience": "Beginners learning computer hardware",
  "learningObjective": "Explain the fundamental differences between RAM (active, fast, volatile memory) and Storage (persistent, large capacity, non-volatile storage).",
  "language": "en",
  "voicePreset": "indian-english-female",
  "sources": [
    {
      "id": "notes-ram-storage",
      "text": "RAM is fast, temporary memory used by the CPU to hold currently active tasks. Storage like SSD or hard drive keeps files permanently even when power is turned off."
    }
  ],
