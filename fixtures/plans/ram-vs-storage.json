      "purpose": "Introduce RAM and storage with a relatable desk analogy.",
      "estimatedDurationMs": 10000,
      "narration": [
        {
          "id": "nar-hook-1",
          "text": "Ever wonder why your computer needs both RAM and storage? They might sound similar, but they do completely different jobs."
        }
      ],
