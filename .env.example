# Copy this file to .env for local work. Never commit .env or real credentials.
# The P0 fixture pipeline does not require provider credentials and makes no provider calls.

GEMINI_API_KEY=
# IMPORTANT: PRD.md specifies gemini-3.8-flash, while PIPELINE_TECHNICAL_DESIGN.md
# implementation notes contain a conflicting default. Resolve this explicitly before P2 live calls.
GEMINI_MODEL=

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_INDIAN_MALE=
ELEVENLABS_VOICE_ID_INDIAN_FEMALE=

# Local MongoDB or MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/visutale

# Better Auth Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Credentials (optional for local email/password testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
