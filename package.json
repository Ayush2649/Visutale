{
  "name": "namastevideo-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Local prototype foundation for NamasteVideo.ai, an educational explainer video pipeline.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "pipeline": "npm run build && node --env-file-if-exists=.env dist/src/cli/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.536",
    "@remotion/media-utils": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.536"
  }
}
