{
  "name": "namastevideo-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Local prototype foundation for NamasteVideo.ai, an educational explainer video pipeline.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build:pipeline": "tsc --project tsconfig.pipeline.json",
    "build": "npm run build:pipeline && next build",
    "test": "npm run build:pipeline && node --test dist/tests/*.test.js",
    "pipeline": "npm run build:pipeline && node --env-file-if-exists=.env dist/src/cli/index.js",
    "dev": "next dev",
    "start": "next start"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.536",
    "@remotion/media-utils": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "autoprefixer": "^10.6.1",
    "better-auth": "^1.7.11",
    "mongodb": "^7.7.0",
    "next": "^14.2.35",
    "postcss": "^8.5.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.536",
    "tailwindcss": "^3.4.19"
  }
}
